--- a/code/renderervk/vk.c
+++ b/code/renderervk/vk.c
@@ -6567,7 +6567,58 @@
 	create_info.subpass = 0;
 	create_info.basePipelineHandle = VK_NULL_HANDLE;
 	create_info.basePipelineIndex = -1;
 
-	VK_CHECK( qvkCreateGraphicsPipelines( vk.device, vk.pipelineCache, 1, &create_info, NULL, &pipeline ) );
+	{
+		VkResult pipeline_result;
+		VkResult original_result;
+		VkRasterizationStateCreateInfo fallback_rasterization_state;
+		VkPipelineMultisampleStateCreateInfo fallback_multisample_state;
+		qboolean fallback_attempted = qfalse;
+
+		pipeline = VK_NULL_HANDLE;
+		pipeline_result = qvkCreateGraphicsPipelines( vk.device, vk.pipelineCache, 1, &create_info, NULL, &pipeline );
+		original_result = pipeline_result;
+
+		/* MoltenVK/Metal may reject non-solid polygon modes or wide lines.
+		 * Keep the original pipeline when it works; retry with portable rasterization. */
+		if ( pipeline_result < 0 && ( rasterization_state.polygonMode != VK_POLYGON_MODE_FILL || rasterization_state.lineWidth != 1.0f ) ) {
+			fallback_rasterization_state = rasterization_state;
+			fallback_rasterization_state.polygonMode = VK_POLYGON_MODE_FILL;
+			fallback_rasterization_state.lineWidth = 1.0f;
+			create_info.pRasterizationState = &fallback_rasterization_state;
+			pipeline = VK_NULL_HANDLE;
+			fallback_attempted = qtrue;
+			pipeline_result = qvkCreateGraphicsPipelines( vk.device, vk.pipelineCache, 1, &create_info, NULL, &pipeline );
+			if ( pipeline_result >= 0 ) {
+				ri.Printf( PRINT_WARNING, "Vulkan: pipeline def#%u pass#%u recovered with fill/1px rasterization (original %s)\n",
+					def_index, renderPassIndex, vk_result_string( original_result ) );
+			}
+		}
+
+		/* Alpha-to-coverage is another optional path that can be problematic on
+		 * some Metal-backed implementations. Retry without it only after the
+		 * rasterization fallback also failed. */
+		if ( pipeline_result < 0 && multisample_state.alphaToCoverageEnable ) {
+			fallback_multisample_state = multisample_state;
+			fallback_multisample_state.alphaToCoverageEnable = VK_FALSE;
+			create_info.pMultisampleState = &fallback_multisample_state;
+			pipeline = VK_NULL_HANDLE;
+			fallback_attempted = qtrue;
+			pipeline_result = qvkCreateGraphicsPipelines( vk.device, vk.pipelineCache, 1, &create_info, NULL, &pipeline );
+			if ( pipeline_result >= 0 ) {
+				ri.Printf( PRINT_WARNING, "Vulkan: pipeline def#%u pass#%u recovered with alpha-to-coverage disabled (original %s)\n",
+					def_index, renderPassIndex, vk_result_string( original_result ) );
+			}
+		}
+
+		if ( pipeline_result < 0 ) {
+			ri.Error( ERR_FATAL, "Vulkan: graphics pipeline failed (def#%u pass#%u shader_type=%i topology=%i polygonMode=%i samples=%i lineWidth=%.2f blend=%i alphaToCoverage=%i fallback=%i original=%s final=%s)",
+				def_index, renderPassIndex, def->shader_type, input_assembly_state.topology,
+				rasterization_state.polygonMode, multisample_state.rasterizationSamples,
+				rasterization_state.lineWidth, attachment_blend_state.blendEnable,
+				multisample_state.alphaToCoverageEnable, fallback_attempted,
+				vk_result_string( original_result ), vk_result_string( pipeline_result ) );
+		}
+	}
 
 	SET_OBJECT_NAME( pipeline, va( "pipeline def#%i, pass#%i", def_index, renderPassIndex ), VK_DEBUG_REPORT_OBJECT_TYPE_PIPELINE_EXT );
